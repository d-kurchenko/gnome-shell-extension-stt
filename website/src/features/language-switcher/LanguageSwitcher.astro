---
import { locales, type Locale } from '../../i18n';
import { localePath } from '../../i18n/routing';

interface Props {
    locale: Locale;
    label: string;
}
const { locale, label } = Astro.props;
const active = locales.find((item) => item.code === locale)!;
---

<details class="language-switcher">
    <summary aria-label={label}>
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
        >
            <circle cx="12" cy="12" r="9" />
            <ellipse cx="12" cy="12" rx="4" ry="9" />
            <path d="M3 12h18" />
        </svg>
        <span lang={locale} dir={active.direction}>
            {active.name}
        </span>
    </summary>
    <nav aria-label={label}>
        {locales.map((item) => (
            <a
                href={localePath(item.code)}
                hreflang={item.code}
                lang={item.code}
                dir={item.direction}
                aria-current={item.code === locale ? 'page' : undefined}
            >
                {item.name}
            </a>
        ))}
    </nav>
</details>
